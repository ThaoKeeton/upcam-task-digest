<winuiex:WindowEx
    x:Class="Upcam.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    MinWidth="640" MinHeight="520">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="RootGrid" RequestedTheme="Default" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="UPCAM · Teambition 工作助手"
        AutomationProperties.AutomationId="app-titlebar"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        IsPaneToggleButtonVisible="True" PaneToggleRequested="TitleBar_PaneToggleRequested">
      <TitleBar.Resources>
        <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
        <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
      </TitleBar.Resources>
      <TitleBar.IconSource>
        <BitmapIconSource UriSource="ms-appx:///Assets/Teambition.png" ShowAsMonochrome="False" />
      </TitleBar.IconSource>
    </TitleBar>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True"
        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
        IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="224"
        SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.Resources>
        <!-- Let the theme-aware root canvas show through both pane states. -->
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
      </NavigationView.Resources>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="主页" Tag="home" Icon="Home" />
        <NavigationViewItem Content="常规" Tag="general" Icon="Setting" />
        <NavigationViewItemHeader Content="配置" />
        <NavigationViewItem Content="账户与模型" Tag="accounts" Icon="Contact" />
        <NavigationViewItem Content="项目范围" Tag="project" Icon="Folder" />
        <NavigationViewItem Content="自动运行" Tag="schedule" Icon="Clock" />
        <NavigationViewItemSeparator />
        <NavigationViewItem Content="运行与诊断" Tag="run" Icon="Play" />
        <NavigationViewItem Content="运行记录" Tag="history" Icon="Document" />
      </NavigationView.MenuItems>
      <Grid Padding="24,12,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock x:Name="PageTitle" Text="主页" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="PageDescription" Text="站会日报 · 本机自动化" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button x:Name="SaveButton" Grid.Column="1" Content="保存本机配置"
              AutomationProperties.AutomationId="save-settings" VerticalAlignment="Top"
              Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
        </Grid>
        <ContentControl x:Name="PageHost" Grid.Row="1"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="正在读取本机配置…" TextWrapping="Wrap" MaxLines="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="CancelDiagnosticButton" Grid.Column="2" Content="停止诊断" Visibility="Collapsed"
                AutomationProperties.AutomationId="cancel-diagnostic" Click="CancelDiagnostic_Click" />
          </Grid>
        </Border>
      </Grid>
    </NavigationView>
  </Grid>
</winuiex:WindowEx>
